{
  "schema": "thingsynth.mapping/2",
  "image": "art/golden-pyramid-with-tunnel-celebration/golden-pyramid-with-tunnel-celebration.jpg",
  "size": [2475, 2475],
  "defaultPreset": "jazz-trio",
  "bindings": [
    {
      "id": "pyramid-drive",
      "label": "The golden pyramid: drag across it for Drive; it heats towards red, deepens and its lines boil",
      "object": "golden-pyramid",
      "param": "amp.drive",
      "range": [0, 1],
      "curve": "linear",
      "gesture": "drag-x",
      "effects": [
        { "effect": "hue", "amount": -0.3 },
        { "effect": "glow", "amount": 1 },
        { "effect": "boil", "amount": 1 }
      ]
    }
  ],
  "regions": [
    {
      "id": "placeholder-drawbar",
      "label": "Placeholder: drag up/down for the Upper 16' drawbar",
      "region": { "polygon": [[1500, 1500], [2300, 1500], [2300, 2300], [1500, 2300]] },
      "gesture": "drag-y",
      "param": "upper.db1",
      "range": [0, 8],
      "curve": "linear"
    },
    {
      "id": "placeholder-rotor",
      "label": "Placeholder: tap to cycle rotor speed (Stop / Slow / Fast)",
      "region": { "rect": [1500, 160, 800, 400] },
      "gesture": "tap",
      "param": "leslie.speed",
      "range": [0, 2],
      "curve": "linear"
    }
  ]
}
