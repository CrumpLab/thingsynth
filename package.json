{
  "name": "thingsynth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "worklet": "node scripts/build_worklet.mjs",
    "dev": "pnpm worklet && vite --config web/vite.config.ts",
    "build": "pnpm worklet && pnpm typecheck && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p web/tsconfig.worklet.json",
    "presets": "node scripts/build_preset_index.mjs",
    "sync": "bash scripts/sync_upstream.sh"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.60",
    "@types/webmidi": "^2.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
