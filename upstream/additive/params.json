{
 "core": "additive",
 "name": "Additive",
 "kind": "synth",
 "version": "0.1.0",
 "description": "Additive core. Tonewheel topology: 91 gear-tuned wheels, busbar matrix with foldback, nine drawbars per manual plus pedals, contact key click, harmonic percussion, scanner vibrato and chorus, tube preamp and a rotary speaker with horn and drum rotors. Partials topology: 64 partials per voice, two 64-level spectra morphed in dB, four group envelopes with decay tilt, a formant curve fixed in Hz, a per-partial spectral filter, stretch and bell ratio sets and an alias fade between 0.40 and 0.45 of the sample rate.",
 "options": {
  "topologies": [
   "tonewheel",
   "partials"
  ],
  "wheels": 91,
  "manuals": 2,
  "manualKeys": 61,
  "pedals": 25,
  "maxPartials": 64,
  "maxVoices": 16
 },
 "parameters": [
  {
   "id": "engine.topology",
