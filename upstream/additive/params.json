    "Off",
    "C1",
    "D1",
    "E1",
    "F1",
    "G1",
    "A1",
    "B1",
    "C2",
    "D2",
    "E2",
    "F2",
    "G2",
    "A2",
    "B2",
    "C3"
   ],
   "default": "Off",
   "description": "Split mode: keys below this note play the pedals (monophonic, lowest note wins). C4 = MIDI 60."
  },
  {
