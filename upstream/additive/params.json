   "group": "Engine",
   "type": "choice",
   "choices": [
    "Tonewheel",
    "Partials"
   ],
   "default": "Tonewheel",
   "description": "Engine option: which instrument this core runs. Fixed per plugin by the manifest default and hidden."
  },
  {
   "id": "voice.manuals",
   "name": "Manual Mode",
   "group": "Voice",
   "type": "choice",
   "choices": [
    "Channels",
    "Split",
    "Upper"
   ],
   "default": "Channels",
   "description": "Channels: upper on MIDI ch 1 (and ch 4..16), lower ch 2, pedals ch 3. Split: one keyboard, keys below Split Point play the lower manual. Upper: every channel plays the upper manual."
  },
  {
   "id": "voice.split",
   "name": "Split Point",
   "group": "Voice",
   "type": "int",
   "min": 36,
   "max": 72,
   "default": 60,
